import Results.TutteThreshold.Solution.AlgRepl
import Results.TutteThreshold.Solution.AlgLoss

/-!
# The finite certificate

* `parClass` classifies the parallel composition of two profiles of `Lab.H`:
  either it is a label (a recognition: the composite has exactly the coordinates of a label, an
  identity of polynomial coordinates checked on coefficient lists — `ε ∥ ε = P₂`, `ε ∥ P₂ = P₃`,
  `S₂ ∥ S₂ = E`, the parallel ones among the paper's pointed isomorphisms, here verified as
  coordinate identities and not as matroid isomorphisms — and the big parallel classes
  `P_a ∥ P_b = P_{a+b}`), or it has a joint replacement.
* `closing_ok`: the closing inequalities for all pairs of profiles.

The table `Cert.row` is the parallel half of the paper's composition table (companion file
`reduced_certificate.json` of the V1-final source archive), generated by `gen/cert_table.py`.
It is checked by kernel evaluation (`Cert.table_ok`, `decide +kernel`) of exact rational
polynomial arithmetic: the coordinates of the labels are polynomials in `x` (`Cert.pcoord`), the
composite (`Cert.ppar`) and the slacks are computed by a small verified arithmetic on coefficient
lists (`Cert.pev_padd`, `Cert.pev_pmul`, ...), and a slack `s` is certified nonnegative on `[2, 3]`
by the partial sums of the coefficients `aₖ` of `s (2 + t)`: if `a₀ + ⋯ + aₖ ≥ 0` for every `k`,
then `∑ aₖ tᵏ ≥ 0` for `0 ≤ t ≤ 1` (`Cert.chk_sound`).  This criterion covers the slacks with
nonnegative coefficients and the paper's exceptional cubics `a + bt + ct² + dt³` (`d < 0`,
`a, b, c + d ≥ 0`); it also gives the closing inequalities (`T² ≤ AB`, via `x ≤ 3`).
-/

namespace Results.TutteThreshold

inductive ParRes
  | label (l : Lab)
  | repl (terms : List ReplTerm)

namespace Cert

/-- The parallel rows `P(H_i, H_j)`, `i ≤ j`, of the paper's composition table by profile index
(`0, …, 6` are `ε, P₂, S₂, P₃, S₃, D, E`, the order of `Lab.H`): the recognitions, the parallel
classes `P₄, P₅, P₆`, and the 21 joint replacements with their terms `(h, u, v, w)`. -/
def row : ℕ → ℕ → ParRes
  -- BEGIN GENERATED by gen/cert_table.py
  | 0, 0 => .label (.p 2)
  | 0, 1 => .label (.p 3)
  | 0, 2 => .repl [⟨.p 1, 5/4, 4/5, 1⟩, ⟨.p 2, 5/3, 3/5, 1⟩]
  | 0, 3 => .label (.p 4)
  | 0, 4 => .repl [⟨.p 1, 393/100, 113/100, 209/100⟩, ⟨.p 2, 139/50, 2/5, 26/25⟩]
  | 0, 5 => .repl [⟨.p 2, 281/100, 164/25, 429/100⟩]
  | 0, 6 => .repl [⟨.p 2, 35/4, 39/20, 103/25⟩]
  | 1, 1 => .label (.p 4)
  | 1, 2 => .repl [⟨.p 2, 617/500, 823/1000, 1007/1000⟩, ⟨.p 3, 349/200, 291/500, 1007/1000⟩]
  | 1, 3 => .label (.p 5)
  | 1, 4 => .repl [⟨.p 2, 393/100, 113/100, 209/100⟩, ⟨.p 3, 139/50, 2/5, 26/25⟩]
  | 1, 5 => .repl [⟨.p 3, 281/100, 164/25, 429/100⟩]
  | 1, 6 => .repl [⟨.p 3, 35/4, 39/20, 103/25⟩]
  | 2, 2 => .label .ee
  | 2, 3 => .repl [⟨.p 3, 293/100, 49/25, 239/100⟩]
  | 2, 4 => .repl [⟨.s 2, 2, 27/50, 103/100⟩, ⟨.ee, 5/4, 59/100, 21/25⟩, ⟨.d, 47/50, 1/25, 9/50⟩]
  | 2, 5 => .repl [⟨.p 2, 411/100, 411/100, 41/10⟩,
      ⟨.ee, 17/100, 29/25, 43/100⟩,
      ⟨.d, 39/50, 9/20, 29/50⟩]
  | 2, 6 => .repl [⟨.p 2, 1371/100, 6/5, 101/25⟩,
      ⟨.ee, 101/100, 31/50, 39/50⟩,
      ⟨.d, 101/100, 1/20, 11/50⟩]
  | 3, 3 => .label (.p 6)
  | 3, 4 => .repl [⟨.p 3, 331/50, 19/10, 353/100⟩]
  | 3, 5 => .repl [⟨.p 3, 137/50, 1277/100, 59/10⟩]
  | 3, 6 => .repl [⟨.p 3, 17/2, 189/50, 283/50⟩]
  | 4, 4 => .repl [⟨.s 2, 177/20, 23/20, 317/100⟩,
      ⟨.ee, 143/100, 33/100, 67/100⟩,
      ⟨.d, 43/50, 1/50, 11/100⟩]
  | 4, 5 => .repl [⟨.p 2, 154/25, 72/25, 21/5⟩,
      ⟨.ee, 61/100, 197/100, 27/25⟩,
      ⟨.d, 197/100, 53/100, 101/100⟩]
  | 4, 6 => .repl [⟨.p 2, 527/25, 83/100, 417/100⟩,
      ⟨.ee, 169/50, 93/100, 44/25⟩,
      ⟨.d, 107/50, 1/20, 31/100⟩]
  | 5, 5 => .repl [⟨.p 2, 653/100, 4567/100, 863/50⟩]
  | 5, 6 => .repl [⟨.p 2, 544/25, 53/4, 1697/100⟩]
