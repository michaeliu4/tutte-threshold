  -- END GENERATED
  -- never reached for profile indices `0..6`: `table_ok` and the lemmas below only use `Lab.H × Lab.H`
  | _, _ => .label (.p 1)

end Cert

/-- classification of `P(l₁, l₂)` for `l₁, l₂ ∈ H` (generated data, checked by `parClass_*`) -/
def parClass (l₁ l₂ : Lab) : ParRes :=
  if Lab.H.idxOf l₁ ≤ Lab.H.idxOf l₂ then Cert.row (Lab.H.idxOf l₁) (Lab.H.idxOf l₂)
  else Cert.row (Lab.H.idxOf l₂) (Lab.H.idxOf l₁)

namespace Cert

/-! ### Polynomials with rational coefficients (constant coefficient first) -/

/-- evaluation (Horner) -/
noncomputable def pev (x : ℝ) : List ℚ → ℝ
  | [] => 0
  | a :: p => a + x * pev x p

/-- sum of polynomials -/
def padd : List ℚ → List ℚ → List ℚ
  | [], q => q
  | a :: p, [] => a :: p
  | a :: p, b :: q => (a + b) :: padd p q

/-- scalar multiple -/
def psmul (c : ℚ) : List ℚ → List ℚ
  | [] => []
  | a :: p => c * a :: psmul c p

/-- product of polynomials -/
def pmul : List ℚ → List ℚ → List ℚ
  | [], _ => []
  | a :: p, q => padd (psmul a q) (0 :: pmul p q)

/-- difference of polynomials -/
def psub (p q : List ℚ) : List ℚ := padd p (psmul (-1) q)

/-- `pshift p` is `t ↦ p (2 + t)` -/
def pshift : List ℚ → List ℚ
  | [] => []
  | a :: p => padd [a] (pmul [2, 1] (pshift p))

/-- the constant coefficient vanishes (then `List.tail` divides by `x`) -/
def headZ : List ℚ → Bool
  | [] => true
  | a :: _ => decide (a = 0)

/-- the partial sums of the coefficients, started at `s`, are nonnegative -/
def psums : ℚ → List ℚ → Bool
  | _, [] => true
  | s, a :: p => decide (0 ≤ s + a) && psums (s + a) p

/-- the certificate for `0 ≤ p` on `[2, 3]` -/
def chk (p : List ℚ) : Bool := psums 0 (pshift p)

lemma pev_nil (x : ℝ) : pev x [] = 0 := rfl

lemma pev_cons (x : ℝ) (a : ℚ) (p : List ℚ) : pev x (a :: p) = a + x * pev x p := rfl

lemma pev_padd (x : ℝ) : ∀ p q : List ℚ, pev x (padd p q) = pev x p + pev x q
  | [], q => by simp only [padd, pev_nil, zero_add]
  | a :: p, [] => by simp only [padd, pev_nil, add_zero]
  | a :: p, b :: q => by simp only [padd, pev_cons, pev_padd x p q, Rat.cast_add]; ring

lemma pev_psmul (x : ℝ) (c : ℚ) : ∀ p : List ℚ, pev x (psmul c p) = c * pev x p
  | [] => by simp only [psmul, pev_nil, mul_zero]
  | a :: p => by simp only [psmul, pev_cons, pev_psmul x c p, Rat.cast_mul]; ring

lemma pev_pmul (x : ℝ) : ∀ p q : List ℚ, pev x (pmul p q) = pev x p * pev x q
  | [], q => by simp only [pmul, pev_nil, zero_mul]
  | a :: p, q => by
    simp only [pmul, pev_padd, pev_psmul, pev_cons, pev_pmul x p q, Rat.cast_zero]; ring

lemma pev_psub (x : ℝ) (p q : List ℚ) : pev x (psub p q) = pev x p - pev x q := by
  simp only [psub, pev_padd, pev_psmul, Rat.cast_neg, Rat.cast_one]; ring

lemma pev_pshift (t : ℝ) : ∀ p : List ℚ, pev t (pshift p) = pev (2 + t) p
  | [] => by simp only [pshift, pev_nil]
  | a :: p => by
    simp only [pshift, pev_padd, pev_pmul, pev_cons, pev_nil, pev_pshift t p, Rat.cast_ofNat,
      Rat.cast_one]
    ring

lemma pev_tail (x : ℝ) {p : List ℚ} (h : headZ p = true) : x * pev x p.tail = pev x p := by
  cases p with
  | nil => simp only [List.tail_nil, pev_nil, mul_zero]
  | cons a p =>
    simp only [headZ, decide_eq_true_eq] at h
    simp only [List.tail_cons, pev_cons, h, Rat.cast_zero, zero_add]

/-- Abel summation: nonnegative partial sums give a nonnegative value on `[0, 1]` -/
lemma psums_sound {t : ℝ} (h0 : 0 ≤ t) (h1 : t ≤ 1) :
    ∀ (p : List ℚ) (s : ℚ), 0 ≤ s → psums s p = true → 0 ≤ (s : ℝ) + pev t p
  | [], s, hs, _ => by simp only [pev_nil, add_zero]; exact_mod_cast hs
  | a :: p, s, _, h => by
    simp only [psums, Bool.and_eq_true, decide_eq_true_eq] at h
    have ih := psums_sound h0 h1 p (s + a) h.1 h.2
    have ha : (0 : ℝ) ≤ s + a := by exact_mod_cast h.1
    push_cast at ih
    simp only [pev_cons]
    nlinarith [mul_nonneg (sub_nonneg.2 h1) ha, mul_nonneg h0 ih]

lemma chk_sound {x : ℝ} (h2 : 2 ≤ x) (h3 : x ≤ 3) {p : List ℚ} (h : chk p = true) :
    0 ≤ pev x p := by
  have := psums_sound (t := x - 2) (by linarith) (by linarith) (pshift p) 0 le_rfl h
  rwa [pev_pshift, Rat.cast_zero, zero_add, add_sub_cancel] at this

/-! ### Coordinates as polynomials -/

/-- six coordinate polynomials `(T, F, A, I, C, B)` -/
structure PC where
  T : List ℚ
  F : List ℚ
  A : List ℚ
  I : List ℚ
  C : List ℚ
  B : List ℚ

/-- evaluation at `x` -/
noncomputable def PC.ev (x : ℝ) (c : PC) : Coord :=
  ⟨pev x c.T, pev x c.F, pev x c.A, pev x c.I, pev x c.C, pev x c.B⟩

/-- the coordinates of the seven profiles and of `P₄, P₅, P₆` (`Lab.coord`) -/
def pcoord : Lab → PC
  | .p 1 => ⟨[1], [1], [0, 1], [], [0, 1], []⟩
  | .p 2 => ⟨[2], [1], [0, 1], [], [0, 0, 1], [0, 1]⟩
  | .p 3 => ⟨[3], [1], [0, 1], [], [0, 0, 0, 1], [0, 1, 1]⟩
  | .p 4 => ⟨[4], [1], [0, 1], [], [0, 0, 0, 0, 1], [0, 1, 1, 1]⟩
  | .p 5 => ⟨[5], [1], [0, 1], [], [0, 0, 0, 0, 0, 1], [0, 1, 1, 1, 1]⟩
  | .p 6 => ⟨[6], [1], [0, 1], [], [0, 0, 0, 0, 0, 0, 1], [0, 1, 1, 1, 1, 1]⟩
  | .s 2 => ⟨[1], [2], [0, 0, 1], [0, 1], [0, 1], []⟩
  | .s 3 => ⟨[1], [3], [0, 0, 0, 1], [0, 1, 1], [0, 1], []⟩
  | .d => ⟨[4], [4], [0, 0, 1], [0, 1], [0, 1, 1, 1], [0, 0, 1]⟩
  | .ee => ⟨[4], [4], [0, 1, 1, 1], [0, 0, 1], [0, 0, 1], [0, 1]⟩
  | _ => ⟨[], [], [], [], [], []⟩

/-- the labels tabulated by `pcoord` -/
def tab : List Lab := [.p 1, .p 2, .s 2, .p 3, .s 3, .d, .ee, .p 4, .p 5, .p 6]

lemma coord_ext {c d : Coord} (hT : c.T = d.T) (hF : c.F = d.F) (hA : c.A = d.A)
    (hI : c.I = d.I) (hC : c.C = d.C) (hB : c.B = d.B) : c = d := by
  cases c; cases d; simp_all

lemma mem_tab {l : Lab} (h : l ∈ Lab.H) : l ∈ tab := by
  simp only [Lab.H, List.mem_cons, List.not_mem_nil, or_false] at h
  rcases h with rfl | rfl | rfl | rfl | rfl | rfl | rfl <;> decide

lemma pcoord_ev {l : Lab} (hl : l ∈ tab) (x : ℝ) : (pcoord l).ev x = l.coord x := by
  simp only [tab, List.mem_cons, List.not_mem_nil, or_false] at hl
  rcases hl with rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl <;>
  apply coord_ext <;>
  simp only [pcoord, PC.ev, Lab.coord, Lab.pk, Coord.dual, Nat.reduceSub, Finset.sum_range_succ,
    Finset.sum_range_zero, pev_cons, pev_nil, Rat.cast_ofNat, Rat.cast_one, Rat.cast_zero,
    Nat.cast_ofNat, Nat.cast_one] <;> ring

/-- `x` times an axis coordinate of a parallel composition -/
def pnum (a i a' i' : List ℚ) : List ℚ :=
  psub (padd (padd (pmul a a') (pmul a i')) (pmul i a')) (pmul (pmul [-1, 1] i) i')

/-- the parallel composition `Coord.par` of polynomial coordinates -/
def ppar (c d : PC) : PC :=
  ⟨padd (pmul c.T d.F) (pmul c.F d.T), pmul c.F d.F, (pnum c.A c.I d.A d.I).tail, pmul c.I d.I,
    pmul c.C d.C, (pnum c.C c.B d.C d.B).tail⟩

/-- the two divisions by `x` in `ppar` are exact -/
def pparOK (c d : PC) : Bool := headZ (pnum c.A c.I d.A d.I) && headZ (pnum c.C c.B d.C d.B)

lemma pev_pnum (x : ℝ) (a i a' i' : List ℚ) :
    pev x (pnum a i a' i') = pev x a * pev x a' + pev x a * pev x i' + pev x i * pev x a' -
      (x - 1) * pev x i * pev x i' := by
  simp only [pnum, pev_psub, pev_padd, pev_pmul, pev_cons, pev_nil, Rat.cast_neg, Rat.cast_one]
  ring

lemma ppar_ev {x : ℝ} (hx : x ≠ 0) {c d : PC} (h : pparOK c d = true) :
    (ppar c d).ev x = Coord.par x (c.ev x) (d.ev x) := by
  simp only [pparOK, Bool.and_eq_true] at h
  have hA := pev_tail x h.1
  have hB := pev_tail x h.2
  rw [pev_pnum] at hA hB
  apply coord_ext <;> simp only [ppar, PC.ev, Coord.par, pev_padd, pev_pmul]
  · rw [eq_div_iff hx, mul_comm, hA]
  · rw [eq_div_iff hx, mul_comm, hB]

lemma par_ev {x : ℝ} (hx : x ≠ 0) {l₁ l₂ : Lab} (h₁ : l₁ ∈ tab) (h₂ : l₂ ∈ tab)
    (h : pparOK (pcoord l₁) (pcoord l₂) = true) :
    Coord.par x (l₁.coord x) (l₂.coord x) = (ppar (pcoord l₁) (pcoord l₂)).ev x := by
  rw [← pcoord_ev h₁, ← pcoord_ev h₂, ppar_ev hx h]

/-! ### Recognitions -/

/-- `p = q` coefficientwise -/
def peq (p q : List ℚ) : Bool := (psub p q).all fun a => decide (a = 0)

lemma pev_eq_zero {x : ℝ} : ∀ {p : List ℚ}, (p.all fun a => decide (a = 0)) = true → pev x p = 0
  | [], _ => rfl
  | a :: p, h => by
    simp only [List.all_cons, Bool.and_eq_true, decide_eq_true_eq] at h
    simp only [pev_cons, h.1, pev_eq_zero h.2, Rat.cast_zero, mul_zero, add_zero]

lemma pev_eq_of_peq {x : ℝ} {p q : List ℚ} (h : peq p q = true) : pev x p = pev x q := by
  have := pev_eq_zero (x := x) h
  rw [pev_psub] at this
  linarith

/-- equality of the six coordinate polynomials -/
def pcEq (c d : PC) : Bool :=
  peq c.T d.T && peq c.F d.F && peq c.A d.A && peq c.I d.I && peq c.C d.C && peq c.B d.B

lemma ev_eq_of_pcEq {x : ℝ} {c d : PC} (h : pcEq c d = true) : c.ev x = d.ev x := by
  simp only [pcEq, Bool.and_eq_true] at h
  obtain ⟨⟨⟨⟨⟨hT, hF⟩, hA⟩, hI⟩, hC⟩, hB⟩ := h
  exact coord_ext (pev_eq_of_peq hT) (pev_eq_of_peq hF) (pev_eq_of_peq hA) (pev_eq_of_peq hI)
    (pev_eq_of_peq hC) (pev_eq_of_peq hB)

/-- `Lab.Big` as a Boolean -/
def bigB : Lab → Bool
  | .p k => decide (4 ≤ k)
  | .s k => decide (4 ≤ k)
  | _ => false

lemma ok_of_bigB {l : Lab} (h : (decide (l ∈ Lab.H) || bigB l) = true) : l.OK := by
  simp only [Bool.or_eq_true, decide_eq_true_eq] at h
  rcases h with h | h
  · exact Or.inl h
  · right
    cases l with
    | p k => exact ⟨k, by simpa [bigB] using h, Or.inl rfl⟩
    | s k => exact ⟨k, by simpa [bigB] using h, Or.inr rfl⟩
    | d => simp [bigB] at h
    | ee => simp [bigB] at h

/-- the check of a recognition `P(l₁, l₂) = l` -/
def checkLabel (l₁ l₂ l : Lab) : Bool :=
  decide (l ∈ tab) && pparOK (pcoord l₁) (pcoord l₂) &&
    pcEq (ppar (pcoord l₁) (pcoord l₂)) (pcoord l) && decide (l.size = l₁.size + l₂.size) &&
    (decide (l ∈ Lab.H) || bigB l)

lemma checkLabel_sound {x : ℝ} (hx : x ≠ 0) {l₁ l₂ l : Lab} (h₁ : l₁ ∈ tab) (h₂ : l₂ ∈ tab)
    (h : checkLabel l₁ l₂ l = true) :
    Coord.par x (l₁.coord x) (l₂.coord x) = l.coord x ∧ l.size = l₁.size + l₂.size ∧ l.OK := by
  simp only [checkLabel, Bool.and_eq_true] at h
  obtain ⟨⟨⟨⟨hl, hok⟩, heq⟩, hsz⟩, hOK⟩ := h
  refine ⟨?_, of_decide_eq_true hsz, ok_of_bigB hOK⟩
  rw [par_ev hx h₁ h₂ hok, ← pcoord_ev (of_decide_eq_true hl)]
  exact ev_eq_of_pcEq heq

/-! ### Joint replacements -/

/-- `∑ f t • g (pcoord t.lab)` over the terms -/
def wsum (f : ReplTerm → ℚ) (g : PC → List ℚ) : List ReplTerm → List ℚ
  | [] => []
  | t :: ts => padd (psmul (f t) (g (pcoord t.lab))) (wsum f g ts)

lemma pev_wsum (x : ℝ) (f : ReplTerm → ℚ) (g : PC → List ℚ) : ∀ ts : List ReplTerm,
    pev x (wsum f g ts) = (ts.map fun t => (f t : ℝ) * pev x (g (pcoord t.lab))).sum
  | [] => by simp only [wsum, pev_nil, List.map_nil, List.sum_nil]
  | t :: ts => by
    simp only [wsum, pev_padd, pev_psmul, pev_wsum x f g ts, List.map_cons, List.sum_cons]

/-- the conditions on one term, `n` being the number of real edges of the composition -/
def termOK (n : ℕ) (t : ReplTerm) : Bool :=
  decide (0 < t.u) && decide (0 < t.v) && decide (0 < t.w) && decide (t.w * t.w ≤ t.u * t.v) &&
    decide (t.lab ∈ Lab.H) && decide (t.lab.size < n)

/-- the check of a joint replacement of `P(l₁, l₂)`: the terms, the two basis budgets and the four
axis slacks -/
def checkRepl (l₁ l₂ : Lab) (ts : List ReplTerm) : Bool :=
  let N := ppar (pcoord l₁) (pcoord l₂)
  pparOK (pcoord l₁) (pcoord l₂) && !ts.isEmpty && ts.all (termOK (l₁.size + l₂.size)) &&
    chk (psub (wsum (·.w) (·.T) ts) N.T) && chk (psub (wsum (·.w) (·.F) ts) N.F) &&
    chk (psub N.A (wsum (·.u) (·.A) ts)) &&
    chk (psub (padd N.A N.I) (wsum (·.u) (fun e => padd e.A e.I) ts)) &&
    chk (psub N.C (wsum (·.v) (·.C) ts)) &&
    chk (psub (padd N.C N.B) (wsum (·.v) (fun e => padd e.C e.B) ts))

lemma checkRepl_sound {x : ℝ} (hx2 : 2 ≤ x) (hx3 : x ≤ 3) {l₁ l₂ : Lab} (h₁ : l₁ ∈ tab)
    (h₂ : l₂ ∈ tab) {ts : List ReplTerm} (h : checkRepl l₁ l₂ ts = true) :
    ReplOK x (Coord.par x (l₁.coord x) (l₂.coord x)) ts ∧ ts ≠ [] ∧
      ∀ t ∈ ts, t.lab ∈ Lab.H ∧ t.lab.size < l₁.size + l₂.size := by
  simp only [checkRepl, Bool.and_eq_true, Bool.not_eq_eq_eq_not, Bool.not_true,
    List.isEmpty_eq_false_iff, List.all_eq_true] at h
  obtain ⟨⟨⟨⟨⟨⟨⟨⟨hok, hne⟩, hts⟩, hT⟩, hF⟩, hA⟩, hAI⟩, hC⟩, hCB⟩ := h
  have hts' : ∀ t ∈ ts, 0 < t.u ∧ 0 < t.v ∧ 0 < t.w ∧ t.w * t.w ≤ t.u * t.v ∧ t.lab ∈ Lab.H ∧
      t.lab.size < l₁.size + l₂.size := by
    intro t ht
    simpa only [termOK, Bool.and_eq_true, decide_eq_true_eq, and_assoc] using hts t ht
  have key : ∀ (f : ReplTerm → ℚ) (g : PC → List ℚ) (G : Coord → ℝ),
      (∀ e : PC, pev x (g e) = G (e.ev x)) →
      pev x (wsum f g ts) = (ts.map fun t => (f t : ℝ) * G (t.lab.coord x)).sum := by
    intro f g G hg
    rw [pev_wsum]
    congr 1
    refine List.map_congr_left fun t ht => ?_
    rw [hg, pcoord_ev (mem_tab (hts' t ht).2.2.2.2.1)]
  have hT' := chk_sound hx2 hx3 hT
  have hF' := chk_sound hx2 hx3 hF
  have hA' := chk_sound hx2 hx3 hA
  have hAI' := chk_sound hx2 hx3 hAI
  have hC' := chk_sound hx2 hx3 hC
  have hCB' := chk_sound hx2 hx3 hCB
  rw [pev_psub, key _ _ (·.T) fun _ => rfl] at hT'
  rw [pev_psub, key _ _ (·.F) fun _ => rfl] at hF'
  rw [pev_psub, key _ _ (·.A) fun _ => rfl] at hA'
  rw [pev_psub, key _ _ (fun c => c.A + c.I) fun _ => pev_padd _ _ _, pev_padd] at hAI'
  rw [pev_psub, key _ _ (·.C) fun _ => rfl] at hC'
  rw [pev_psub, key _ _ (fun c => c.C + c.B) fun _ => pev_padd _ _ _, pev_padd] at hCB'
  rw [par_ev (ne_of_gt (by linarith)) h₁ h₂ hok]
  refine ⟨⟨fun t ht => ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩, hne,
    fun t ht => ⟨(hts' t ht).2.2.2.2.1, (hts' t ht).2.2.2.2.2⟩⟩
  · obtain ⟨hu, hv, hw, hwuv, -⟩ := hts' t ht
    refine ⟨hu, hv, hw, ?_⟩
    rw [sq]
    exact_mod_cast hwuv
  all_goals simp only [PC.ev]; linarith

/-! ### Closing and the whole table -/

/-- the check of the closing inequality `T² ≤ A B` for `P(l₁, l₂)` -/
def checkClose (l₁ l₂ : Lab) : Bool :=
  let N := ppar (pcoord l₁) (pcoord l₂)
  pparOK (pcoord l₁) (pcoord l₂) && chk (psub (pmul N.A N.B) (pmul N.T N.T))

lemma checkClose_sound {x : ℝ} (hx2 : 2 ≤ x) (hx3 : x ≤ 3) {l₁ l₂ : Lab} (h₁ : l₁ ∈ tab)
    (h₂ : l₂ ∈ tab) (h : checkClose l₁ l₂ = true) :
    (Coord.par x (l₁.coord x) (l₂.coord x)).T ^ 2 ≤
      (Coord.par x (l₁.coord x) (l₂.coord x)).A * (Coord.par x (l₁.coord x) (l₂.coord x)).B := by
  simp only [checkClose, Bool.and_eq_true] at h
  have := chk_sound hx2 hx3 h.2
  rw [pev_psub, pev_pmul, pev_pmul] at this
  rw [par_ev (ne_of_gt (by linarith)) h₁ h₂ h.1]
  simp only [PC.ev]
  nlinarith [this]

/-- the check of one entry of the table -/
def resOK (l₁ l₂ : Lab) : ParRes → Bool
  | .label l => checkLabel l₁ l₂ l
  | .repl ts => checkRepl l₁ l₂ ts

/-- the whole certificate: all 49 ordered pairs of profiles, by kernel evaluation -/
theorem table_ok : (Lab.H.all fun l₁ => Lab.H.all fun l₂ =>
    resOK l₁ l₂ (parClass l₁ l₂) && checkClose l₁ l₂) = true := by
  decide +kernel

lemma entry_ok {l₁ l₂ : Lab} (h₁ : l₁ ∈ Lab.H) (h₂ : l₂ ∈ Lab.H) :
    resOK l₁ l₂ (parClass l₁ l₂) = true ∧ checkClose l₁ l₂ = true := by
  have h := List.all_eq_true.1 table_ok l₁ h₁
  simpa only [Bool.and_eq_true] using List.all_eq_true.1 h l₂ h₂

end Cert

lemma parClass_label {x : ℝ} (hx2 : 2 ≤ x) {l₁ l₂ l : Lab} (h₁ : l₁ ∈ Lab.H) (h₂ : l₂ ∈ Lab.H)
    (h : parClass l₁ l₂ = ParRes.label l) :
    Coord.par x (l₁.coord x) (l₂.coord x) = l.coord x ∧ l.size = l₁.size + l₂.size ∧ l.OK := by
  have hc := (Cert.entry_ok h₁ h₂).1
  rw [h] at hc
  exact Cert.checkLabel_sound (ne_of_gt (by linarith)) (Cert.mem_tab h₁) (Cert.mem_tab h₂) hc

lemma parClass_repl {x : ℝ} (hx2 : 2 ≤ x) (hx3 : x ≤ 3) {l₁ l₂ : Lab} (h₁ : l₁ ∈ Lab.H)
    (h₂ : l₂ ∈ Lab.H) {terms : List ReplTerm} (h : parClass l₁ l₂ = ParRes.repl terms) :
    ReplOK x (Coord.par x (l₁.coord x) (l₂.coord x)) terms ∧ terms ≠ [] ∧
      ∀ t ∈ terms, t.lab ∈ Lab.H ∧ t.lab.size < l₁.size + l₂.size := by
  have hc := (Cert.entry_ok h₁ h₂).1
  rw [h] at hc
  exact Cert.checkRepl_sound hx2 hx3 (Cert.mem_tab h₁) (Cert.mem_tab h₂) hc

-- the membership hypotheses of the frozen statement are not needed
set_option linter.unusedVariables false in
/-- every pair of profiles is either recognised or replaced -/
lemma parClass_total {l₁ l₂ : Lab} (h₁ : l₁ ∈ Lab.H) (h₂ : l₂ ∈ Lab.H) :
    (∃ l, parClass l₁ l₂ = ParRes.label l) ∨ ∃ terms, parClass l₁ l₂ = ParRes.repl terms := by
  cases parClass l₁ l₂ with
  | label l => exact Or.inl ⟨l, rfl⟩
  | repl terms => exact Or.inr ⟨terms, rfl⟩

/-- closing a pair of profiles: `ρ ≥ 1`, i.e. `T'² ≤ A' B'` for the composite -/
theorem closing_ok {x : ℝ} (hx : 2 ≤ x) (hxs : x ^ 3 ≤ 9 * (x - 1)) {l₁ l₂ : Lab}
    (h₁ : l₁ ∈ Lab.H) (h₂ : l₂ ∈ Lab.H) :
    (Coord.par x (l₁.coord x) (l₂.coord x)).T ^ 2 ≤
      (Coord.par x (l₁.coord x) (l₂.coord x)).A * (Coord.par x (l₁.coord x) (l₂.coord x)).B := by
  have hx3 : x ≤ 3 := by
    by_contra hc
    have h3 : 0 < x - 3 := by linarith [not_le.1 hc]
    nlinarith [mul_pos h3 (by nlinarith : (0 : ℝ) < x ^ 2 + 3 * x)]
  exact Cert.checkClose_sound hx hx3 (Cert.mem_tab h₁) (Cert.mem_tab h₂) (Cert.entry_ok h₁ h₂).2

end Results.TutteThreshold
