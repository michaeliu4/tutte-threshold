import Mathlib.Combinatorics.Matroid.Rank.ENat
import Mathlib.Combinatorics.Matroid.Circuit
import Mathlib.Combinatorics.Matroid.Map
import Mathlib.Analysis.Real.Sqrt

/-!
# Definitions for the multiplicative Merino–Welsh threshold on matroids

Statement layer for "The sharp threshold for the multiplicative Merino–Welsh inequality on
matroids" (M. Liu).  Everything here is about Mathlib's `Matroid`.  A matroid is finite when its
ground set is (`[M.Finite]`); the type `α` carrying it is arbitrary and may be larger than the
ground set (loops, coloops and circuits lie in the ground set, and `tutte` sums over subsets of the
ground set, so elements of `α` outside it play no role).

* `tutte M x y` — the Tutte polynomial of a finite matroid, by the rank generating function
  `T_M(x,y) = ∑_{S ⊆ E} (x-1)^{r(M)-r(S)} (y-1)^{|S|-r(S)}`;
* `IsAdmissible M` — no loops and no coloops;
* `numComponents M` — the number of connected components: the classes of the equivalence relation
  generated by "contained in a common circuit" (by Oxley, Prop. 4.1.2, two elements are in the
  same class iff they are equal or lie in a common circuit; a coloop lies in no circuit and is a
  class by itself);
* `rho M x = T_M(x,0) T_M(0,x) / T_M(1,1)^2`;
* `cFun x = √(x³ / (9 (x-1)))`;
* `uniformMatroid r n` — the uniform matroid `U_{r,n}` on `Fin n`;
* `doubling k` — `U_{2k,3k}` with every element replaced by a parallel pair.
-/

open Matroid

namespace Results.TutteThreshold

noncomputable section

variable {α : Type*}

/-- The rank of a set in `M`, as a natural number (every set of a finite matroid has finite rank). -/
def rk (M : Matroid α) (S : Set α) : ℕ := (M.eRk S).toNat

/-- The Tutte polynomial of a finite matroid, via the rank generating function
`T_M(x,y) = ∑_{S ⊆ E} (x-1)^{r(M)-r(S)} (y-1)^{|S|-r(S)}`. -/
def tutte (M : Matroid α) [M.Finite] (x y : ℝ) : ℝ :=
  ∑ S ∈ M.ground_finite.toFinset.powerset,
    (x - 1) ^ (M.eRank.toNat - rk M (S : Set α)) * (y - 1) ^ (S.card - rk M (S : Set α))

/-- A matroid is admissible if it has neither loops nor coloops. -/
def IsAdmissible (M : Matroid α) : Prop := (∀ e, ¬ M.IsLoop e) ∧ (∀ e, ¬ M.IsColoop e)

/-- Two elements of the ground set are related if some circuit contains both. -/
def componentRel (M : Matroid α) (e f : M.E) : Prop :=
  ∃ C, M.IsCircuit C ∧ (e : α) ∈ C ∧ (f : α) ∈ C

/-- The number of connected components: the number of classes of the equivalence relation
generated by `componentRel` on the ground set (`Quot` identifies exactly the elements joined by a
chain of related elements; the empty matroid has no component).  It is the intended count for
finite matroids.  `Nat.card` is `0` when there are infinitely many classes; an infinite ground set
can still have finitely many classes (an infinite set of pairwise parallel elements has one). -/
def numComponents (M : Matroid α) : ℕ := Nat.card (Quot (componentRel M))

/-- `ρ_x(M) = T_M(x,0) T_M(0,x) / T_M(1,1)²`. -/
def rho (M : Matroid α) [M.Finite] (x : ℝ) : ℝ :=
  tutte M x 0 * tutte M 0 x / (tutte M 1 1) ^ 2

/-- `c(x) = √(x³ / (9 (x-1)))`. -/
def cFun (x : ℝ) : ℝ := Real.sqrt (x ^ 3 / (9 * (x - 1)))

/-- The uniform matroid `U_{r,n}` on `Fin n`: a set is independent iff it has at most `r`
elements (for `n ≤ r` this is the free matroid on `Fin n`). -/
def uniformMatroid (r n : ℕ) : Matroid (Fin n) :=
  (IndepMatroid.ofFinite (E := Set.univ) Set.finite_univ (fun I => I.ncard ≤ r)
    (by simp)
    (fun I J hJ hIJ => (Set.ncard_le_ncard hIJ (Set.toFinite J)).trans hJ)
    (fun I J hI hJ hIJ => by
      obtain ⟨e, heJ, heI⟩ := Set.exists_mem_notMem_of_ncard_lt_ncard hIJ
      refine ⟨e, heJ, heI, ?_⟩
      rw [Set.ncard_insert_of_notMem heI (Set.toFinite I)]
      omega)
    (fun _ _ => Set.subset_univ _)).matroid

/-- `U_{2k,3k}` with every element replaced by a parallel pair: the pullback of the uniform
matroid along the two-to-one projection `Fin (3k) × Fin 2 → Fin (3k)`. -/
def doubling (k : ℕ) : Matroid (Fin (3 * k) × Fin 2) :=
  (uniformMatroid (2 * k) (3 * k)).comap Prod.fst

end

end Results.TutteThreshold
